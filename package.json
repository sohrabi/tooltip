{
  "name": "@sohrabi/tooltip",
  "version": "2.0.0",
  "description": "A tiny, dependency-free and accessible tooltip for JavaScript and TypeScript.",
  "keywords": [
    "tooltip",
    "accessible",
    "dependency-free",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/sohrabi/tooltip#readme",
  "bugs": {
    "url": "https://github.com/sohrabi/tooltip/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohrabi/tooltip.git"
  },
  "license": "ISC",
  "author": "Eqbal Sohrabi",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/tooltip.min.js",
  "jsdelivr": "./dist/tooltip.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs && npm run size",
    "size": "node scripts/check-size.mjs",
    "test": "vitest run",
    "test:package": "node scripts/check-package.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "20.11.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
